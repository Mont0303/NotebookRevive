// =========================================================
// fastfetch — Tactical Amber Cyberdeck (Motion Plus Q464B)
// =========================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "yellow"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "yellow"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS   "
        },
        {
            "type": "kernel",
            "key": "KRNL "
        },
        {
            "type": "wm",
            "key": "WM   "
        },
        {
            "type": "terminal",
            "key": "TERM "
        },
        "break",
        {
            "type": "cpu",
            "key": "CPU  "
        },
        {
            "type": "memory",
            "key": "MEM  "
        },
        {
            "type": "disk",
            "key": "DISK "
        },
        {
            "type": "battery",
            "key": "BAT  "
        },
        "break",
        {
            "type": "uptime",
            "key": "UP   "
        },
        {
            "type": "packages",
            "key": "PKGS "
        }
    ]
}
