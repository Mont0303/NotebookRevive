# =========================================================
# dunst — Tactical Amber Notificações (Cyberdeck Q464B)
# =========================================================

[global]
    monitor = 0
    follow = mouse

    width = 320
    height = 300
    origin = top-right
    offset = 14x14
    scale = 0

    notification_limit = 4
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#ff9e3b"
    separator_color = frame
    sort = yes

    font = JetBrains Mono 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    dmenu = rofi -dmenu -theme ~/.config/rofi/config.rasi -p dunst
    browser = qutebrowser

    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#0d0e11"
    foreground = "#e6dfd3"
    frame_color = "#70624e"
    timeout = 5

[urgency_normal]
    background = "#0d0e11"
    foreground = "#e6dfd3"
    frame_color = "#ff9e3b"
    timeout = 8

[urgency_critical]
    background = "#0d0e11"
    foreground = "#ff4d4d"
    frame_color = "#ff4d4d"
    timeout = 0

[battery_low]
    appname = "*battery*"
    background = "#0d0e11"
    foreground = "#ff4d4d"
    frame_color = "#ff4d4d"
    timeout = 10
