# =========================================================
# betterlockscreen — MIL-SPEC Tactical Lockscreen (Cyberdeck Q464B)
# =========================================================

# cor do texto em âmbar militar
text_color=ff9e3b

# fonte do relógio/hora
font="JetBrains Mono"

# formato hora/data militar
time_format="%H:%M:%S"
full_date_format="SYS-DATE // %A, %d/%m/%Y"

# dim no wallpaper para aspecto tático
blur_level=2
dim_level=45

greeter_supported=false
